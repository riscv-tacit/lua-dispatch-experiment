{
  "name": "lua-fuse-leimul",
  "base": "br-base.json",
  "overlay": "overlay",
  "host-init": "host-init.sh",
  "command": "cd /root/lua-dispatch && ./lua-leimul bench/mandelbrot.lua 900 && ./lua-leimul-gt127 bench/mandelbrot.lua 900 && echo LUA_ALL_OK",
  "jobs": [
    {
      "name": "leimul-mandelbrot-traced",
      "command": "cd /root/lua-dispatch && ./trace-run ./lua-leimul bench/mandelbrot.lua 900",
      "firesim": { "simulation_outputs": [ "tacit0.out" ] }
    },
    {
      "name": "leimul-gt127-mandelbrot-traced",
      "command": "cd /root/lua-dispatch && ./trace-run ./lua-leimul-gt127 bench/mandelbrot.lua 900",
      "firesim": { "simulation_outputs": [ "tacit0.out" ] }
    },
    {
      "name": "leimul-chores",
      "command": "sh /root/lua-dispatch/run-chores.sh",
      "outputs": [ "/root/chores/driver_map.txt", "/root/chores/jump_label_patch_map.txt" ]
    }
  ]
}
