# build products of the interpreter trees; the binaries that were actually run are
# identified by md5 in each tree's manifest.json
*.o
*.a
*/src/lua
*/src/luac
luac.out
# interpreter binaries and the compiled trace-run inside the FireMarshal overlays are
# installed by the AE image stage from the trees above; only sources are tracked
workloads/*/overlay/root/lua-dispatch/lua
workloads/*/overlay/root/lua-dispatch/lua-*
workloads/*/overlay/root/lua-dispatch/trace-run
